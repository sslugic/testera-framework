# Primary AI Provider (cursor | gemini | anthropic | openai | mock)
# Auto-detects from Luna AI workspace ../luna-ai/.env when unset or mock.
AI_PROVIDER=cursor

# Provider API Keys (or inherit from Luna AI workspace .env)
CURSOR_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model Overrides (Optional)
# CURSOR_MODEL=composer-2.5
# ANTHROPIC_MODEL=claude-3-7-sonnet-20250219
# OPENAI_MODEL=gpt-4o

# Browser Options
HEADLESS=true
SLOW_MO=0
BROWSER=chromium
RECORD_SCREENSHOTS=true

# Safety Guardrails (block destructive account/data actions during autonomous exploration)
SAFE_MODE=true
